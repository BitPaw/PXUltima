<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="PXUltima" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="../[Export]/PXUltimaC/64B-Linux-Debug/libPXUltima.so" prefix_auto="0" extension_auto="0" />
				<Option working_dir="../[Export]/PXUltimaC/64B-Linux-Debug/" />
				<Option object_output="../[Temp]/PXUltimaC/64B-Linux-Debug/" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-fPIC" />
					<Add option="-m64" />
					<Add option="-g" />
					<Add option="-DXLIB_ILLEGAL_ACCESS" />
					<Add option="-D_GNU_SOURCE" />
					<Add directory="../PXUltimaC" />
				</Compiler>
				<Linker>
					<Add option="-m64" />
					<Add library="GL" />
					<Add library="X11" />
					<Add library="pthread" />
					<Add library="libm" />
					<Add library="Xext" />
					<Add library="Xi" />
					<Add library="dl" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="../[Export]/PXUltimaC/64B-Linux-Release/libPXUltima.so" imp_lib="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).a" def_file="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).def" prefix_auto="0" extension_auto="0" />
				<Option working_dir="../[Export]/PXUltimaC/64B-Linux-Release/" />
				<Option object_output="../[Temp]/PXUltimaC/64B-Linux-Release/" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-Os" />
					<Add option="-fPIC" />
					<Add option="-DXLIB_ILLEGAL_ACCESS" />
					<Add directory="../PXUltimaC" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="GL" />
					<Add library="X11" />
					<Add library="pthread" />
					<Add library="libm" />
					<Add library="Xext" />
					<Add library="Xi" />
					<Add library="dl" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
		</Compiler>
